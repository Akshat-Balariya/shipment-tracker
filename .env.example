# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# "True" only for local debugging. Must stay False on the EC2 instance.
DJANGO_DEBUG=False

# Comma-separated. Set to the web server's current public IP (and domain, if added).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# RDS master password — from the password manager, not from here.
DB_PASSWORD=

# HTTP Basic Auth credentials for /admin-panel/
ADMIN_USER=admin
ADMIN_PASSWORD=
